# ReClaude CLIProxy Gateway environment file.
# Copy to /etc/reclaude-cliproxy-gateway.env on Ubuntu.

# Listen address for callers such as CLIProxy/NewAPI.
# Keep 127.0.0.1 if callers run on the host. Use 0.0.0.0 only behind a firewall.
RECLAUDE_GATEWAY_LISTEN=127.0.0.1:58400

# Local upstream daemon address.
# Leave unset to read the current port from state.json on each request.
# RECLAUDE_DAEMON_ADDR=127.0.0.1:58391

# auto: inject Claude/reclaude token if found; otherwise pass incoming auth through.
# inject: require a token to be found.
# pass: never inject a token.
RECLAUDE_GATEWAY_AUTH=auto

# Optional explicit token. Prefer file-based auth over putting tokens here.
# RECLAUDE_GATEWAY_TOKEN=

# State and auth files. Device auth is preferred over fallback CLI credentials.
RECLAUDE_STATE_PATH=/home/ubuntu/.reclaude/state.json
RECLAUDE_CA_PATH=/home/ubuntu/.reclaude/ca.pem
RECLAUDE_DEVICE_PATH=/home/ubuntu/.reclaude/device.json
RECLAUDE_CLAUDE_CREDENTIALS_PATH=/home/ubuntu/.claude/.credentials.json
RECLAUDE_CLAUDE_STATE_PATH=/home/ubuntu/.claude.json

# Access logs are written to journald when the gateway runs under systemd.
RECLAUDE_ACCESS_LOG=true
